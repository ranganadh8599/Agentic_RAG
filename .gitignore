# ------------------------------------------------------------------
# Secrets & environment — never commit real credentials
# ------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
!.env.example

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------
# Runtime logs
# ------------------------------------------------------------------
logs/

# ------------------------------------------------------------------
# Local dev / test artifacts — kept on disk for future use, NOT committed
# ------------------------------------------------------------------
# root-level test harnesses (rewrite/cache/scope/features)
/test_*.py
# sample documents uploaded for evaluation
docs_upload/
# recall regression history (regenerated by recall_check.py)
recall_history.json
# RAGAS eval history (regenerated by eval_ragas.py)
ragas_history.json
# captured eval/test output files
*_result.txt
# judged ground-truth eval datasets (kept local)
recall_dataset.json
ragas_eval_dataset.json
docs_upload_eval.json
# standalone dev/eval tools (not imported by the app; run manually)
benchmark_rerank.py
eval_ragas.py
make_fixtures.py
preview_docs.py
recall_check.py

# ------------------------------------------------------------------
# Testing / linting / coverage caches
# ------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ------------------------------------------------------------------
# Logs & runtime data
# ------------------------------------------------------------------
*.log
logs/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------
# Test fixtures (generated sample data — not for VCS)
# ------------------------------------------------------------------
fixtures/

