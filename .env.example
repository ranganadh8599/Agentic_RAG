# Copy to .env and fill in. Everything is optional — "mock" values work offline.

# --- PostgreSQL (vector store for documents/chunks/semantic cache) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_rag

# --- MongoDB (users + chat history) ---
# Run a local mongod:  C:\mongodb\...\bin\mongod.exe --dbpath C:\mongodb\data --port 27017 --bind_ip 127.0.0.1
# NOTE: mongod is a manual background process (not a service) — restart it after a reboot.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=agentic_rag
# How long a login token stays valid (seconds). 2592000 = 30 days.
SESSION_TTL_SECONDS=2592000

# --- Embeddings (pick ONE provider) ---
# OPENAI:        EMBEDDING_MODEL=openai/text-embedding-3-small  + OPENAI_API_KEY=sk-...
# GEMINI:        EMBEDDING_MODEL=gemini/text-embedding-004      + GEMINI_API_KEY=...
# OLLAMA (local):EMBEDDING_MODEL=ollama/nomic-embed-text         (no key)
# Offline test:  EMBEDDING_MODEL=mock
EMBEDDING_MODEL=mock
EMBEDDING_DIM=1536
# Turn ON only for local sentence-transformers models (bge/nomic/minilm)
USE_ASYMMETRIC_PREFIX=0

# --- LLM (pick ONE provider) ---
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_MODEL=anthropic/claude-3-5-sonnet
# LLM_MODEL=ollama/llama3
LLM_MODEL=mock

# Vision model for reading images (any vision-capable model)
VISION_MODEL=mock

# API keys (used by litellm automatically)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional tuning ---
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=100
# TOP_K=6
# USE_QUERY_EXPANSION=1
# SEMANTIC_CACHE_THRESHOLD=0.90
# RELEVANCE_FLOOR=0.25
# GENERAL_STRONG_THRESHOLD=0.72
#
# --- Ingestion ---
# MAX_IMAGES_PER_PDF=20
# MAX_IMAGE_DIM=1200
# MAX_PAGES=0                      # 0 = whole document
# STRUCTURED_KEYWORDS=resume,cv,curriculum,profile,form,application
# EMBED_BATCH_SIZE=32
#
# --- Upload limits (0 = unlimited) ---
# MAX_UPLOAD_MB=0                  # max size of a single uploaded file in MB
# MAX_UPLOAD_FILES=0               # max files accepted per batch/selection
#
# --- Agents / citations ---
# MAX_CRITIC_ROUNDS=2
# ROUTER_MAX_TOKENS=100
# CRITIC_MAX_TOKENS=300
# CITATION_OVERLAP_THRESHOLD=0.25
# SNIPPET_MAX_CHARS=220
# SNIPPET_WINDOW=40
#
# --- Retrieval ---
# QUERY_EMBED_CACHE_SIZE=256
# KEYWORD_TITLE_BOOST=2.0
# FILENAME_MATCH_SCORE=3.0
# RETRIEVAL_MULTIPLIER=2
# MEMORY_RECENT_K=8
# MEMORY_RELEVANT_K=4
#
# --- Vision / images ---
# IMAGE_JPEG_QUALITY=85
# VISION_SUMMARY_MAX_TOKENS=500
#
# --- pgvector ---
# HNSW_VECTOR_DIM_LIMIT=2000       # above this dims, embeddings use halfvec
